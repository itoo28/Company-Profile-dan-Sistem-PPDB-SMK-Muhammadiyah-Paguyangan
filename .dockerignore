# Git & Version Control
.git
.github
.gitignore
.gitattributes

# Environment & Secret files
.env
.env.*
!.env.example

# Local dependencies & caches
/vendor
/node_modules
/public/build
/public/storage
/public/hot

# Storage & Framework runtime caches
storage/*.key
storage/pail
storage/logs/*
